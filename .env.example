# NIFSERVER Dashboard — copy to .env (never commit .env).
# On the server, keep it outside the repo with `chmod 600`, e.g. /etc/nifserver/nifserver.env

# ---- Backend API ----
NODE_ENV=production
# Bind to loopback only. Verify the port is free with `ss -ltnp` first.
API_HOST=127.0.0.1
API_PORT=3001

ADMIN_USERNAME=admin
# Generate with: cd backend && npm run hash-password
ADMIN_PASSWORD_HASH=

SESSION_TTL_HOURS=12
# auto: Secure cookie when the request came over HTTPS (Cloudflare), plain on HTTP LAN.
# true/false force it either way.
COOKIE_SECURE=auto

NETDATA_URL=http://127.0.0.1:19999
NETDATA_TIMEOUT_MS=3000

# Absolute path to the folder holding services.json / applications.json
CONFIG_DIR=/opt/nifserver/config
SHARED_PATH=/srv/shared

# Sample data for UI development away from the server. Keep false in production.
MOCK_MODE=false

# ---- Hosting Manager (see deploy/hosting/README.md) ----
HOSTING_ENABLED=true
# Linux default /srv/nifhost; elsewhere ../.hosting-dev (git-ignored).
#HOSTING_ROOT=/srv/nifhost
# systemd: real builds/units (requires `sudo bash deploy/hosting/install.sh <user>`).
# simulated: development only — nothing is built or started. Default: systemd on Linux unless MOCK_MODE.
#HOSTING_EXECUTOR=systemd
# Gateway serving hosted sites; must match NIFHOST_GATEWAY_PORT in nifhost-gateway.service.
HOSTING_GATEWAY_PORT=8090
# Loopback ports handed out to process apps (Next.js, Node, Laravel, PHP). Check with `ss -ltnp`.
HOSTING_PORT_MIN=4100
HOSTING_PORT_MAX=4199
HOSTING_MAX_UPLOAD_MB=50
HOSTING_MAX_EXTRACTED_MB=300
# Deployments per 15 minutes (uploads + GitHub).
HOSTING_DEPLOY_LIMIT=10
# Git hosts allowed as deploy sources (HTTPS only, comma-separated).
HOSTING_GIT_HOSTS=github.com
# Hostnames hosted apps may never claim.
HOSTING_RESERVED_HOSTS=drive.nifserver.cloud,panel.nifserver.cloud
HOSTING_BASE_DOMAIN=nifserver.cloud
# Read-only: used to show whether a domain already has a tunnel ingress rule.
HOSTING_CLOUDFLARED_CONFIG=/etc/cloudflared/config.yml

# ---- Frontend ----
# Where Next.js forwards /api/v1/* (used when Nginx is not routing /api directly).
BACKEND_URL=http://127.0.0.1:3001
